Computer = [RAJU, ARUN, VIKRAM, JOHN]
Science = [ARUN, JOHN, DAVID]
Maths = [RAJU, JOHN, KIRAN]

Only One Subject
[VIKRAM, DAVID, KIRAN]
Exactly Two Subjects
[RAJU, ARUN]
